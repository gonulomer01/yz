@{
    Layout = null;
    bool isAdmin = User.IsInRole("Yönetici");
    string displayName = User.FindFirst("DisplayName")?.Value ?? User.Identity?.Name ?? "Kullanıcı";
    string userId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "0";
}
<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Mega Image Studio — Yapay Zeka Görsel Üretim Platformu</title>
  <meta name="description" content="Mega Image Studio Yapay Zeka Görsel Üretim ve Çoklu Hesap Rotasyon Platformu.">
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet">
  
  <link rel="stylesheet" href="~/css/main.css" asp-append-version="true">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <link rel="icon" href="~/images/logo.png" type="image/png">
</head>
<body data-is-admin="@(isAdmin ? "true" : "false")" data-user-id="@userId">

  <div class="ambient-bg">
  </div>

  <div class="app-layout" id="app-layout">
    <!-- Sol Yan Menü (Collapsible Sidebar) -->
    @await Html.PartialAsync("Partials/_Sidebar")

    <!-- Mobil Karartma Perdesi (Backdrop) -->
    <div id="sidebar-backdrop" class="sidebar-backdrop"></div>

    <!-- Sağ Ana İçerik Alanı -->
    <main class="main-content" id="main-content">
      <!-- Mobile Only Brand Header -->
              <div class="mobile-brand-header">
          <img src="/images/logo.png" alt="Mega Image Studio">
          <div class="brand-text">
            <span class="brand-primary">MEGA IMAGE <span class="brand-highlight">STUDIO</span></span>
            <span class="brand-subtitle"><i class="fa-solid fa-sparkles"></i> Görsel Platformu</span>
          </div>
        </div>
      <!-- Üst Bilgi Çubuğu (Top Bar) -->
      @await Html.PartialAsync("Partials/_TopBar")

    <!-- === STÜDYO EKRANI === -->
    @await Html.PartialAsync("Partials/_Studio")

    @if (isAdmin)
    {
        <!-- === YÖNETİM PANELİ EKRANI (SADECE YÖNETİCİLER İÇİN) === -->
        @await Html.PartialAsync("Partials/_Dashboard")
    }

    <!-- === KULLANICI PROFİLİM EKRANI (SAĞ ANA İÇERİK ALANI) === -->
    @await Html.PartialAsync("Partials/_Profile")

    <div id="triple-group-modal" class="modal-overlay" style="display:none">
      <div class="modal-box glass-card" style="width: 100%; max-width: 1000px; max-height: 90vh; display: flex; flex-direction: column;">
        <div class="modal-header">
          <h3><i class="fa-solid fa-layer-group" style="color: var(--color-primary);"></i> Üçlü Üretim Sonuçları</h3>
          <button id="btn-triple-group-close" class="modal-close"><i class="fa-solid fa-xmark"></i></button>
        </div>
        <div style="padding: 15px; flex: 1; overflow-y: auto;">
          <p style="margin-bottom: 15px; color: var(--text-main); font-weight: 500; opacity: 0.9;" id="triple-group-prompt"></p>
          <div id="triple-group-container" style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 15px; overflow-x: auto;">
          </div>
        </div>
        <div class="modal-actions" style="margin-top: 0;">
          <button type="button" id="btn-triple-group-download-all" class="action-btn"><i class="fa-solid fa-download"></i> Toplu İndir</button>
          <button type="button" id="btn-triple-group-ok" class="action-btn primary-btn"><i class="fa-solid fa-check"></i> Tamam</button>
        </div>
      </div>
    </div>

    <div id="single-image-modal" class="modal-overlay" style="display:none">
      <div class="modal-box glass-card" style="width: 100%; max-width: 600px; max-height: 90vh; display: flex; flex-direction: column;">
        <div class="modal-header">
          <h3><i class="fa-solid fa-image" style="color: var(--color-primary);"></i> Görsel Detayı</h3>
          <button id="btn-single-image-close" class="modal-close"><i class="fa-solid fa-xmark"></i></button>
        </div>
        <div style="padding: 15px; flex: 1; overflow-y: auto;">
          <p style="margin-bottom: 15px; color: var(--text-main); font-weight: 500; opacity: 0.9;" id="single-image-prompt"></p>
          <div id="single-image-container" style="display: flex; justify-content: center; align-items: center; background: var(--bg-hover-light); border-radius: 8px; padding: 10px;">
          </div>
        </div>
        <div class="modal-actions" style="margin-top: 0;">
          <a href="#" id="btn-single-image-download" download class="action-btn"><i class="fa-solid fa-download"></i> İndir</a>
          <button type="button" id="btn-single-image-ok" class="action-btn primary-btn"><i class="fa-solid fa-check"></i> Tamam</button>
        </div>
      </div>
    </div>

    <!-- === TAM EKRAN GÖRSEL GÖRÜNTÜLEME & İNDİRME MODALI (LIGHTBOX) === -->
    <div id="fullscreen-image-modal" class="fullscreen-lightbox-overlay" style="display:none">
      <button id="btn-fullscreen-close" class="fullscreen-lightbox-close" title="Kapat (ESC)">
        <i class="fa-solid fa-xmark"></i>
      </button>
      <div class="fullscreen-lightbox-content">
        <img id="fullscreen-image-img" src="" alt="Tam ekran görsel">
        <div class="fullscreen-lightbox-caption" id="fullscreen-image-caption"></div>
      </div>
      <div class="fullscreen-lightbox-actions">
        <a href="#" id="btn-fullscreen-download" download class="action-btn primary-btn btn-lg-download">
          <i class="fa-solid fa-download"></i> Bu Görseli İndir
        </a>
      </div>
    </div>

    <!-- === GÖRSEL ARŞİVİ EKRANI === -->
    @await Html.PartialAsync("Partials/_Gallery")

    <!-- === KOLEKSİYONLAR EKRANI === -->
    @await Html.PartialAsync("Partials/_Collections")

    <!-- === FAVORİLER EKRANI === -->
    @await Html.PartialAsync("Partials/_Favorites")




    <!-- === ÇÖP KUTUSU EKRANI === -->
    @await Html.PartialAsync("Partials/_Trash")
  </main>
</div>

<!-- Klasör Oluşturma / Düzenleme Modalı -->
<div id="folderModalOverlay" class="modal-overlay" style="display:none;">
  <div class="modal-box glass-card">
    <div class="modal-header">
      <h3 id="folderModalTitle"><i class="fa-solid fa-folder-plus" style="color: var(--color-primary);"></i> Yeni Klasör Oluştur</h3>
      <button type="button" class="modal-close" onclick="closeFolderModal()"><i class="fa-solid fa-xmark"></i></button>
    </div>
    <form onsubmit="event.preventDefault(); document.getElementById('btnSaveFolder').click();">
      <div class="field">
        <label for="folderNameInput">Klasör Adı</label>
        <input type="text" id="folderNameInput" placeholder="Örn: Manzaralar, Portreler, Mimari..." autofocus>
      </div>
      <div class="modal-actions">
        <button type="button" class="action-btn" onclick="closeFolderModal()">İptal</button>
        <button type="button" class="action-btn primary-btn" id="btnSaveFolder">
          <i class="fa-solid fa-check"></i> Kaydet
        </button>
      </div>
    </form>
  </div>
</div>

<!-- Klasöre Taşı Modalı -->
<div id="moveFolderModalOverlay" class="modal-overlay" style="display:none;">
  <div class="modal-box glass-card">
    <div class="modal-header">
      <h3><i class="fa-solid fa-folder-open" style="color: var(--color-primary);"></i> Klasöre Taşı</h3>
      <button type="button" class="modal-close" onclick="closeMoveFolderModal()"><i class="fa-solid fa-xmark"></i></button>
    </div>
    <form onsubmit="event.preventDefault(); document.getElementById('btnConfirmMoveFolder').click();">
      <div class="field">
        <label for="moveFolderSelect">Hedef Klasör</label>
        <div class="select-wrap">
          <select id="moveFolderSelect">
            <option value="">— Klasörsüz (Kaldır) —</option>
          </select>
          <i class="fa-solid fa-chevron-down"></i>
        </div>
      </div>
      <div class="field" style="margin-top: 10px;">
        <label for="moveFolderNewName">veya yeni klasör adı yazın:</label>
        <input type="text" id="moveFolderNewName" placeholder="Yeni klasör adı...">
      </div>
      <div class="modal-actions">
        <button type="button" class="action-btn" onclick="closeMoveFolderModal()">İptal</button>
        <button type="button" class="action-btn primary-btn" id="btnConfirmMoveFolder">
          <i class="fa-solid fa-arrow-right-to-bracket"></i> Taşı
        </button>
      </div>
    </form>
  </div>
</div>


  <!-- Koleksiyona Görsel Ekle Modal -->
  <div id="collectionAddModalOverlay" class="modal-overlay" style="display:none;">
    <div class="modal-box glass-card" style="width: 100%; max-width: 800px; max-height: 90vh; display: flex; flex-direction: column;">
      <div class="modal-header">
        <h3 style="color:var(--text-main);"><i class="fa-solid fa-images" style="color: var(--color-primary);"></i> Koleksiyona Görsel Seç</h3>
        <button class="modal-close" onclick="closeCollectionAddModal()"><i class="fa-solid fa-xmark"></i></button>
      </div>
      <div style="padding: 15px; flex: 1; overflow-y: auto;">
        <div id="collectionAddGrid" class="gallery-grid-main"></div>
      </div>
      <div class="modal-actions" style="margin-top: 0; padding: 15px; border-top: 1px solid var(--border-color); flex-shrink: 0;">
        <button class="action-btn" onclick="closeCollectionAddModal()">İptal</button>
        <button id="btnConfirmCollectionAdd" class="action-btn primary-btn">
            <i class="fa-solid fa-check"></i> Ekle
        </button>
      </div>
    </div>
  </div>

    <!-- Mobile Bottom Bar -->
    <nav class="mobile-bottom-bar" id="mobile-bottom-bar">
      <button class="bottom-nav-item" onclick="document.getElementById('nav-favorites').click()" title="Favoriler">
        <i class="fa-regular fa-heart"></i>
        <span>Favoriler</span>
      </button>
      <button class="bottom-nav-item" onclick="document.getElementById('nav-collections').click()" title="Koleksiyonlar">
        <i class="fa-solid fa-box-archive"></i>
        <span>Koleksiyonlar</span>
      </button>
      <button class="bottom-nav-item active-bottom" onclick="document.getElementById('nav-studio').click()" title="Stüdyo">
        <i class="fa-solid fa-wand-magic-sparkles"></i>
        <span>Stüdyo</span>
      </button>
      <button class="bottom-nav-item" onclick="document.getElementById('btn-gallery-toggle').click()" title="Arşiv">
        <i class="fa-solid fa-images"></i>
        <span>Arşiv</span>
      </button>

      <button class="bottom-nav-item" onclick="document.getElementById('nav-trash').click()" title="Çöp Kutusu">
        <i class="fa-solid fa-trash-can"></i>
        <span>Çöp Kutusu</span>
      </button>
    </nav>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
  <script src="~/js/app.js?v=@DateTime.Now.Ticks"></script>
</body>
</html>
