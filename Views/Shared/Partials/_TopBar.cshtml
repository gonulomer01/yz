@{
    bool isAdmin = User.IsInRole("Yönetici");
    string displayName = User.FindFirst("DisplayName")?.Value ?? User.Identity?.Name ?? "Kullanıcı";
}
<header class="top-bar glass-card">
        <div style="display: flex; align-items: center; gap: 10px;">
          <div class="top-bar-title" id="page-title-heading">
            <i class="fa-solid fa-wand-magic-sparkles"></i> <h2>Stüdyo</h2>
          </div>
        </div>
        <div class="top-bar-right">
          <div class="notification-badge-container" style="position: relative; margin-right: 15px; display: flex; align-items: center;">
            <div class="notification-icon" onclick="toggleNotificationDropdown(event)" style="cursor: pointer; position: relative;" title="Bildirimler">
              <i class="fa-solid fa-bell" style="font-size: 1.2rem; color: var(--text-muted); transition: color 0.2s;"></i>
              <span class="notif-badge" id="top-notif-count" style="display:none; position: absolute; top: -5px; right: -8px; background: var(--color-danger); color: white; font-size: 0.65rem; font-weight: bold; padding: 2px 5px; border-radius: 10px; border: 2px solid var(--bg-card);">0</span>
            </div>
            <!-- Notification Dropdown Menu -->
            <div id="notification-dropdown-menu" class="glass-card" style="display:none; position: absolute; top: 40px; right: -10px; width: 320px; padding: 0; z-index: 1000; overflow: hidden; box-shadow: 0 10px 25px rgba(0,0,0,0.2); border: 1px solid var(--border-color); border-radius: 12px; background: var(--bg-surface);">
                <div style="padding: 12px 15px; border-bottom: 1px solid var(--border-color); background: rgba(0,0,0,0.05); font-weight: 600; display: flex; justify-content: space-between; align-items: center;">
                    <span>Bildirimler</span>
                </div>
                <div id="top-notifications-list" style="max-height: 350px; overflow-y: auto; display: flex; flex-direction: column; gap: 0;">
                    <div id="top-notifications-empty" style="padding: 30px 20px; text-align: center; color: var(--text-muted);">
                      <i class="fa-regular fa-bell-slash" style="font-size: 1.5rem; margin-bottom: 10px;"></i>
                      <p style="font-size: 0.9rem; margin: 0;">Henüz bildiriminiz yok.</p>
                    </div>
                </div>
            </div>
          </div>
          <label class="theme-switch" title="Karanlık/Aydınlık Mod Değiştir" style="margin-right: 15px;">
            <input type="checkbox" id="theme-toggle-btn" style="display:none;" />
            <div class="theme-slider">
              <i class="fa-solid fa-moon"></i>
              <i class="fa-solid fa-sun"></i>
              <div class="theme-slider-thumb"></div>
            </div>
          </label>
          <div class="user-badge-container" style="position: relative;">
            <div class="user-badge-info" onclick="toggleUserDropdown(event)" style="cursor: pointer;" title="Menüyü Aç">
            <i class="fa-solid fa-user-shield"></i>
            <div class="user-info-text">
              <span class="user-name">@displayName</span>
              <span class="role-badge @(isAdmin ? "role-admin" : "role-user")">@(isAdmin ? "Yönetici" : "Kullanıcı")</span>
            </div>
            <i class="fa-solid fa-chevron-down" style="font-size: 0.8rem; margin-left: 5px; opacity: 0.7;"></i>
          </div>
          <!-- Dropdown Menu -->
          <div id="user-dropdown-menu" class="user-dropdown-menu glass-card" style="display:none;">
            @if (isAdmin)
            {
                <button type="button" class="dropdown-item" onclick="document.getElementById('nav-dashboard').click(); document.getElementById('user-dropdown-menu').style.display='none';">
                    <i class="fa-solid fa-sliders" style="width: 20px;"></i> Yönetim Paneli
                </button>
            }
            <button type="button" class="dropdown-item" onclick="document.getElementById('btn-profile').click(); document.getElementById('user-dropdown-menu').style.display='none';">
                <i class="fa-solid fa-user-gear" style="width: 20px;"></i> Bilgileri Güncelle
            </button>

            <form asp-controller="Home" asp-action="Logout" method="post" style="margin:0;">
                @Html.AntiForgeryToken()
                <button type="submit" class="dropdown-item dropdown-logout">
                    <i class="fa-solid fa-right-from-bracket" style="width: 20px;"></i> Çıkış Yap
                </button>
            </form>
          </div>
          </div><!-- end user-badge-container -->
          <button id="btn-batch-download" class="chip-btn primary-chip" style="display:none;" title="Tüm Üretimleri Zip Olarak İndir (Resim + Prompt TXT)">
            <i class="fa-solid fa-file-zipper"></i> Toplu Ziple & İndir
          </button>
        </div>
      </header>